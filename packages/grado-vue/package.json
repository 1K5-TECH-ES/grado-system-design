{
  "name": "@1k5-tech-es/grado-vue",
  "version": "0.4.0",
  "description": "Componentes Vue del sistema de diseño Grado de 1KOMMA5° España.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1K5-TECH-ES/grado-system-design.git",
    "directory": "packages/grado-vue"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vee-validate": {
      "types": "./dist/vee-validate.d.ts",
      "default": "./dist/vee-validate.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@1k5-tech-es/grado": "^0.4.0"
  },
  "peerDependencies": {
    "vue": ">=3.5",
    "vee-validate": ">=4.12"
  },
  "peerDependenciesMeta": {
    "vee-validate": {
      "optional": true
    }
  }
}
