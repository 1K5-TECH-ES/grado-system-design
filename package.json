{
  "name": "grado-monorepo",
  "private": true,
  "description": "Sistema de diseño de 1KOMMA5° España",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && node --test \"test/*.test.mjs\"",
    "contrast": "npm run contrast -w @1k5-tech-es/grado",
    "api": "npm run build && node scripts/api.mjs",
    "api:check": "node scripts/api.mjs check",
    "size": "node scripts/size.mjs",
    "catalog": "npm run build && node scripts/catalog.mjs",
    "docs:build": "npm run build && node scripts/docs.mjs && npm pack --workspaces --pack-destination docs-site/dist/downloads",
    "docs:check": "node --test \"docs-site/test/*.test.mjs\"",
    "docs:serve": "node scripts/serve.mjs",
    "test:browser": "npm run build && node test/browser/run.mjs",
    "test:visual": "npm run catalog && playwright test",
    "test:all": "npm run lint && npm test && npm run api:check && npm run size && npm run test:browser && npm run test:visual && npm run docs:build && npm run docs:check",
    "lint": "eslint . && stylelint \"packages/grado/src/css/*.css\" \"docs-site/assets/*.css\" && prettier --check .",
    "format": "prettier --write . && eslint . --fix && stylelint \"packages/grado/src/css/*.css\" \"docs-site/assets/*.css\" --fix",
    "release:check": "node scripts/release.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "axe-core": "4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "tailwindcss3": "npm:tailwindcss@3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42"
  },
  "engines": {
    "node": ">=20"
  }
}
